{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "pnpm build",
  "outputDirectory": "dist/public",
  "functions": {
    "api/**/*.ts": { "maxDuration": 10 }
  },
  "rewrites": [
    { "source": "/search", "destination": "/index.html" },
    { "source": "/credits", "destination": "/index.html" },
    { "source": "/title/:path*", "destination": "/index.html" },
    { "source": "/watch/:path*", "destination": "/index.html" }
  ]
}
